@model ProductViewModel
@{
    ViewData["Title"] = "Productos";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Productos</h2>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i>
            Agregar producto
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle">
                    <thead class="table-dark">
                        <tr>
                            <th>ID</th>
                            <th>Nombre</th>
                            <th>Descripción</th>
                            <th>Calificación</th>
                            <th>Comentarios</th>
                            <th>Creado por</th>
                            <th>Fecha de creación</th>
                            <th>Modificado por</th>
                            <th>Fecha de modificación</th>
                            <th class="text-center">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Products != null && Model.Products.Any())
                        {
                            foreach (var product in Model.Products)
                            {
                                <tr>
                                    <td>@product.ProductId</td>
                                    <td><strong>@product.Name</strong></td>
                                    <td>@product.Description</td>
                                    <td>
                                        @for (int i = 1; i <= 5; i++)
                                        {
                                            if (i <= product.Rating)
                                            {
                                                <span class="text-warning">★</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">☆</span>
                                            }
                                        }
                                    </td>
                                    <td>@product.Comments</td>
                                    <td>@product.CreatedBy</td>
                                    <td>@product.CreatedDate.ToString("yyyy-MM-dd HH:mm")</td>
                                    <td>@product.ModifiedBy</td>
                                    <td>@product.ModifiedDate.ToString("yyyy-MM-dd HH:mm")</td>
                                    <td class="text-center">
                                        <div class="btn-group" role="group">
                                            <a asp-action="Edit" asp-route-id="@product.Id"
                                               class="btn btn-sm btn-warning">Editar</a>
                                            <a asp-action="Details" asp-route-id="@product.Id"
                                               class="btn btn-sm btn-info">Detalles</a>
                                            <a asp-action="Delete" asp-route-id="@product.Id"
                                               class="btn btn-sm btn-danger">Eliminar</a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="10" class="text-center">No se encontraron productos.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
